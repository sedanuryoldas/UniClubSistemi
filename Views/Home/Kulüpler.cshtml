@{
    ViewData["Title"] = "Üniversite Kulüpleri";
}

<div class="container mt-4 pb-5">
    <div class="text-center mb-5">
        <h2 class="fw-bold display-6 text-primary">🏫 Üniversite Kulüp Rehberi</h2>
        <p class="text-muted">Kendi ilgi alanına uygun kulübü bul ve hemen topluluğa katıl!</p>
    </div>

    <div class="row g-4">
        <div class="col-md-3">
            <div class="card h-100 border-0 shadow-sm text-center p-3 rounded-4">
                <div class="fs-1 py-3">💻</div>
                <h5 class="fw-bold">Yazılım Kulübü</h5>
                <p class="small text-muted">Geleceğin dünyasını kodlarla inşa ediyoruz.</p>
                <button class="btn btn-sm btn-outline-primary rounded-pill">İncele</button>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card h-100 border-0 shadow-sm text-center p-3 rounded-4">
                <div class="fs-1 py-3">🎭</div>
                <h5 class="fw-bold">Tiyatro Kulübü</h5>
                <p class="small text-muted">Sahne ışıklarının altında yeteneğini sergile.</p>
                <button class="btn btn-sm btn-outline-danger rounded-pill">İncele</button>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card h-100 border-0 shadow-sm text-center p-3 rounded-4">
                <div class="fs-1 py-3">🎸</div>
                <h5 class="fw-bold">Müzik Topluluğu</h5>
                <p class="small text-muted">Kampüsü müziğin ritmiyle canlandırıyoruz.</p>
                <button class="btn btn-sm btn-outline-warning rounded-pill">İncele</button>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card h-100 border-0 shadow-sm text-center p-3 rounded-4">
                <div class="fs-1 py-3">🏔️</div>
                <h5 class="fw-bold">Doğa Sporları</h5>
                <p class="small text-muted">Zirveleri keşfetmek için bize katıl.</p>
                <button class="btn btn-sm btn-outline-success rounded-pill">İncele</button>
            </div>
        </div>
    </div>
</div>