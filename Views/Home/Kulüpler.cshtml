@model List<UniClubSistemi.Models.Kulup>
@{
    ViewData["Title"] = "Kulüpler Rehberi";
}

<div class="container mt-5 text-center pb-5">
    <div class="mb-5">
        <h1 class="display-4 fw-bold text-white mb-3">🏫 Üniversite Kulüp Rehberi</h1>
        <p class="text-white-50 fs-5">Kendi ilgi alanına uygun kulübü bul ve hemen topluluğa katıl!</p>
    </div>

    <div class="row justify-content-center">
        @if (Model == null || Model.Count == 0)
        {
            <div class="alert alert-light text-center rounded-4 opacity-75">Sistemde henüz kulüp bulunmuyor.</div>
        }
        else
        {
            @foreach (var item in Model)
            {
                <div class="col-md-3 mb-4">
                    <div class="card shadow-lg border-0 rounded-4 h-100 p-3">
                        <div class="card-body d-flex flex-column align-items-center">
                            <!-- Başlık  -->
                            <h5 class="fw-bold text-primary mb-3">@item.Ad</h5>

                            <p class="text-muted small flex-grow-1">
                                @(item.Aciklama.Length > 60 ? item.Aciklama.Substring(0, 60) + "..." : item.Aciklama)
                            </p>

                            <!-- İNCELE BUTONU -->
                            <button class="btn btn-outline-primary rounded-pill px-4 mt-auto w-100 mb-2"
                                    data-bs-toggle="modal" data-bs-target="#kulupModal"
                                    data-ad="@item.Ad"
                                    data-baskan="@item.Baskan"
                                    data-uye="@item.UyeSayisi"
                                    data-kurulus="@item.KurulusYili"
                                    data-aciklama="@item.Aciklama">
                                İncele
                            </button>

                            <!-- SADECE ADMİNLER İÇİN SİLME BUTONU  -->
                            @if (User.IsInRole("Admin"))
                            {
                                <form asp-action="KulupSil" method="post" onsubmit="return confirm('Bu kulübü tamamen silmek istediğine emin misin?');">
                                    <input type="hidden" name="id" value="@item.Id" />
                                    <button type="submit" class="btn btn-link text-danger small p-0 fw-bold text-decoration-none">
                                        <i class="bi bi-trash3-fill"></i> Kulübü Sil
                                    </button>
                                </form>
                            }
                        </div>
                    </div>
                </div>
            }
        }
    </div>
</div>

<!-- KULÜP DETAY MODAL -->
<div class="modal fade" id="kulupModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content rounded-4 border-0 shadow-lg">
            <div class="modal-header border-0 pb-0 text-center d-block relative">
                <button type="button" class="btn-close position-absolute top-0 end-0 m-3" data-bs-dismiss="modal" aria-label="Close"></button>
                <h4 class="modal-title fw-bold text-primary mt-4 mb-2 fs-3" id="modalAd">Kulüp Adı</h4>
            </div>
            <div class="modal-body pt-3 pb-4 px-4">
                <div class="d-flex justify-content-between text-muted small mb-3 border-bottom pb-3">
                    <div><i class="bi bi-person-badge-fill text-primary"></i> Başkan: <strong class="text-dark" id="modalBaskan">-</strong></div>
                    <div><i class="bi bi-people-fill text-success"></i> Üye: <strong class="text-dark" id="modalUye">-</strong></div>
                    <div><i class="bi bi-calendar-star-fill text-warning"></i> Kuruluş: <strong class="text-dark" id="modalKurulus">-</strong></div>
                </div>
                <p class="text-secondary mb-0" id="modalAciklama" style="line-height:1.7;">Açıklama yükleniyor...</p>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        var kulupModal = document.getElementById('kulupModal');
        kulupModal.addEventListener('show.bs.modal', function (event) {
            var button = event.relatedTarget;

            document.getElementById('modalAd').textContent = button.getAttribute('data-ad');
            document.getElementById('modalBaskan').textContent = button.getAttribute('data-baskan');
            document.getElementById('modalUye').textContent = button.getAttribute('data-uye');
            document.getElementById('modalKurulus').textContent = button.getAttribute('data-kurulus');
            document.getElementById('modalAciklama').textContent = button.getAttribute('data-aciklama');
        });
    </script>
}