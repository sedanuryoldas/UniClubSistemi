@{
    ViewData["Title"] = "Üniversite Kulüpleri";
}

<div class="container mt-4 pb-5">
    <div class="text-center py-5 mb-5 rounded-5 shadow-lg" style="background: rgba(255, 255, 255, 0.05); backdrop-filter: blur(15px); border: 1px solid rgba(255, 255, 255, 0.1);">
        <h1 class="display-4 fw-bold text-white mb-2">
            <span class="fs-2">🏫</span> Üniversite Kulüp Rehberi
        </h1>
        <p class="lead text-warning fw-semibold opacity-90">Kendi ilgi alanına uygun kulübü bul ve hemen topluluğa katıl!</p>
    </div>

    <div class="row g-4">
        <div class="col-md-3">
            <div class="card h-100 border-0 shadow-sm text-center p-3 rounded-4">
                <div class="fs-1 py-3">💻</div>
                <h5 class="fw-bold text-dark">Yazılım Kulübü</h5>
                <p class="small text-muted">Geleceğin dünyasını kodlarla inşa ediyoruz.</p>
                <div class="mt-auto">
                    <button class="btn btn-sm btn-outline-primary rounded-pill px-4 fw-bold">İncele</button>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card h-100 border-0 shadow-sm text-center p-3 rounded-4">
                <div class="fs-1 py-3">🎭</div>
                <h5 class="fw-bold text-dark">Tiyatro Kulübü</h5>
                <p class="small text-muted">Sahne ışıklarının altında yeteneğini sergile.</p>
                <div class="mt-auto">
                    <button class="btn btn-sm btn-outline-danger rounded-pill px-4 fw-bold">İncele</button>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card h-100 border-0 shadow-sm text-center p-3 rounded-4">
                <div class="fs-1 py-3">🎸</div>
                <h5 class="fw-bold text-dark">Müzik Topluluğu</h5>
                <p class="small text-muted">Kampüsü müziğin ritmiyle canlandırıyoruz.</p>
                <div class="mt-auto">
                    <button class="btn btn-sm btn-outline-warning rounded-pill px-4 fw-bold">İncele</button>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card h-100 border-0 shadow-sm text-center p-3 rounded-4">
                <div class="fs-1 py-3">🏔️</div>
                <h5 class="fw-bold text-dark">Doğa Sporları</h5>
                <p class="small text-muted">Zirveleri keşfetmek için bize katıl.</p>
                <div class="mt-auto">
                    <button class="btn btn-sm btn-outline-success rounded-pill px-4 fw-bold">İncele</button>
                </div>
            </div>
        </div>
    </div>
</div>