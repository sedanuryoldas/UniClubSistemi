@{
    ViewData["Title"] = "Yeni Etkinlik Paylaş";
}

<div class="container mt-5 pb-5">
    <div class="row justify-content-center">
        <div class="col-lg-7">
            <div class="card shadow-lg border-0 rounded-4">
                <div class="card-header bg-primary text-white py-4 text-center rounded-top-4">
                    <h2 class="fw-bold mb-0">📣 Etkinlik Oluştur</h2>
                    <p class="mb-0 opacity-75">Kampüsteki herkese kulübünü duyur!</p>
                </div>
                <div class="card-body p-5">
                    <form>
                        <div class="mb-4">
                            <label class="form-label fw-bold">Etkinlik Başlığı</label>
                            <input type="text" class="form-control form-control-lg border-2" placeholder="Örn: Kariyer Zirvesi 2026">
                        </div>

                        <div class="row mb-4">
                            <div class="col-md-6">
                                <label class="form-label fw-bold">Etkinlik Tarihi</label>
                                <input type="date" class="form-control border-2">
                            </div>
                            <div class="col-md-6">
                                <label class="form-label fw-bold">Konum / Yer</label>
                                <input type="text" class="form-control border-2" placeholder="Örn: Kültür Merkezi B Salonu">
                            </div>
                        </div>

                        <div class="mb-4">
                            <label class="form-label fw-bold">Hangi Kulüp Düzenliyor?</label>
                            <select class="form-select border-2">
                                <option selected disabled>Kulüp Seçin</option>
                                <option>Yazılım Kulübü</option>
                                <option>Tiyatro Kulübü</option>
                                <option>Gezi ve Doğa Sporları</option>
                                <option>Müzik Kulübü</option>
                            </select>
                        </div>

                        <div class="mb-4">
                            <label class="form-label fw-bold">Etkinlik Detayları</label>
                            <textarea class="form-control border-2" rows="5" placeholder="Etkinliğin içeriği, katılım şartları vb. bilgiler..."></textarea>
                        </div>

                        <div class="d-grid gap-2">
                            <button class="btn btn-primary btn-lg fw-bold shadow-sm py-3" type="button">🚀 Etkinliği Yayına Al</button>
                            <a asp-action="Index" class="btn btn-link text-muted text-decoration-none">Vazgeç ve Ana Sayfaya Dön</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>