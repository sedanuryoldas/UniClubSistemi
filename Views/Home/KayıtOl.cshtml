@{
    ViewData["Title"] = "Kulüp Kayıt Formu";
}

<div class="container mt-5 pb-5">
    <div class="row justify-content-center">
        <div class="col-md-6 col-lg-5">
            <div class="card shadow-lg border-0 rounded-4">
                <div class="card-body p-5">
                    <div class="text-center mb-4">
                        <div class="display-1 text-primary mb-2">
                            <span class="fs-1">📝</span>
                        </div>
                        <h2 class="fw-bold text-dark">Kulüp Kaydı</h2>
                        <p class="text-muted small">UniClub yönetim sistemine dahil olun</p>
                    </div>

                    @if (ViewBag.Hata != null)
                    {
                        <div class="alert alert-danger text-center small rounded-3">
                            @ViewBag.Hata
                        </div>
                    }

                    <form asp-action="KayıtOl" method="post">
                        <div class="mb-3">
                            <label class="form-label fw-bold text-secondary">Kulüp Adı</label>
                            <div class="input-group">
                                <span class="input-group-text bg-light border-end-0"><i class="bi bi-building"></i></span>
                                <input type="text" name="kulupAdi" class="form-control bg-light border-start-0" placeholder="Örn: Teknoloji ve Yazılım Kulübü" required>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-bold text-secondary">E-posta Adresi</label>
                            <div class="input-group">
                                <span class="input-group-text bg-light border-end-0"><i class="bi bi-envelope"></i></span>
                                <input type="email" name="email" class="form-control bg-light border-start-0" placeholder="kulup@universite.edu.tr" required>
                            </div>
                        </div>

                        <div class="mb-4">
                            <label class="form-label fw-bold text-secondary">Şifre Belirleyin</label>
                            <div class="input-group">
                                <span class="input-group-text bg-light border-end-0"><i class="bi bi-lock"></i></span>
                                <input type="password" name="sifre" class="form-control bg-light border-start-0" placeholder="••••••••" required minlength="8">
                            </div>
                            <div class="form-text mt-1 text-xs">Şifreniz en az 8 karakter olmalıdır.</div>
                        </div>

                        <div class="d-grid gap-2">
                            <button type="submit" class="btn btn-primary btn-lg rounded-pill shadow-sm fw-bold">
                                Kayıt Talebini Gönder
                            </button>
                        </div>
                    </form>

                    <hr class="my-4 text-muted opacity-25">

                    <div class="text-center">
                        <p class="small text-muted mb-0">Zaten bir hesabınız var mı?</p>
                        <a asp-action="Giriş" class="fw-bold text-primary text-decoration-none">Giriş Yap</a>
                    </div>
                </div>
            </div>

            <div class="text-center mt-4">
                <a asp-action="Index" class="text-muted small text-decoration-none">← Ana Sayfaya Dön</a>
            </div>
        </div>
    </div>
</div>