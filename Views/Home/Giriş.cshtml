@{
    ViewData["Title"] = "Giriş Yap";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-4">
            <div class="card shadow border-0 rounded-4">
                <div class="card-body p-5">
                    <div class="text-center mb-4">
                        <span class="fs-1">🔑</span>
                        <h3 class="fw-bold mt-2">Yönetim Paneli</h3>
                        <p class="text-muted small">Kulüp temsilcisi girişi</p>
                    </div>

                    @if (ViewBag.Hata != null)
                    {
                        <div class="alert alert-danger text-center small rounded-pill">
                            @ViewBag.Hata
                        </div>
                    }

                    <form asp-action="Giriş" method="post">
                        <div class="mb-3">
                            <label class="form-label">E-posta</label>
                            <input type="email" name="email" class="form-control rounded-pill" placeholder="ornek@uniclub.com" required>
                        </div>
                        <div class="mb-4">
                            <label class="form-label">Şifre</label>
                            <input type="password" name="sifre" class="form-control rounded-pill" placeholder="••••••••" required>
                        </div>
                        <div class="d-grid">
                            <button type="submit" class="btn btn-primary btn-lg rounded-pill shadow-sm">Giriş Yap</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>